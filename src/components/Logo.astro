---
// The ColTex mark (apps/web/src/components/brand.tsx): a sigma on a plain blue tile.
const { class: className = 'size-7' } = Astro.props
---

<span class:list={['inline-flex shrink-0 items-center justify-center rounded-md bg-primary text-primary-foreground', className]}>
  <svg viewBox="0 0 24 24" class="size-[60%]" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M18 7V5a1 1 0 0 0-1-1H6.5a.5.5 0 0 0-.4.8l4.5 6a2 2 0 0 1 0 2.4l-4.5 6a.5.5 0 0 0 .4.8H17a1 1 0 0 0 1-1v-2"></path>
  </svg>
</span>
