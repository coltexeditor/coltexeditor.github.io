---
import { dictionary, type Lang } from '../i18n/index.ts'
import { INSTALL_COMMAND } from '../lib/install-spec.ts'

const { lang } = Astro.props as { lang: Lang }
const t = dictionary(lang)
---

<div class="install-command flex w-full max-w-2xl items-center gap-3 rounded-xl border border-border bg-card py-2 pr-2 pl-4 shadow-sm">
  <code class="min-w-0 flex-1 overflow-x-auto py-1.5 font-mono text-[13px] whitespace-nowrap sm:text-sm">
    <span class="text-muted-foreground select-none">$ </span>{INSTALL_COMMAND}
  </code>
  <button
    type="button"
    class="copy relative flex h-9 shrink-0 items-center gap-1.5 rounded-lg bg-primary px-3 text-sm font-medium text-primary-foreground transition-transform active:scale-95"
    data-command={INSTALL_COMMAND}
  >
    <svg viewBox="0 0 24 24" class="icon-copy size-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <rect width="14" height="14" x="8" y="8" rx="2"></rect><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path>
    </svg>
    <svg viewBox="0 0 24 24" class="icon-done hidden size-4" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M20 6 9 17l-5-5"></path>
    </svg>
    <span class="label">{t.hero.copy}</span>
    <span class="label-done hidden">{t.hero.copied}</span>
  </button>
</div>

<script>
  // Copies the command; falls back to a hidden text area where the Clipboard API is missing.
  async function copy(text: string) {
    try {
      await navigator.clipboard.writeText(text)
      return
    } catch {}
    const area = document.createElement('textarea')
    area.value = text
    area.style.position = 'fixed'
    area.style.opacity = '0'
    document.body.append(area)
    area.select()
    document.execCommand('copy')
    area.remove()
  }
  for (const button of document.querySelectorAll<HTMLButtonElement>('.install-command .copy')) {
    let timer = 0
    button.addEventListener('click', async () => {
      await copy(button.dataset.command!)
      const swap = (done: boolean) => {
        button.querySelector('.icon-copy')!.classList.toggle('hidden', done)
        button.querySelector('.label')!.classList.toggle('hidden', done)
        button.querySelector('.icon-done')!.classList.toggle('hidden', !done)
        button.querySelector('.label-done')!.classList.toggle('hidden', !done)
      }
      swap(true)
      clearTimeout(timer)
      timer = window.setTimeout(() => swap(false), 1800)
    })
  }
</script>
